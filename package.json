{
  "name": "englishfluency-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "migrate:local": "wrangler d1 migrations apply englishfluency --local",
    "migrate:remote": "wrangler d1 migrations apply englishfluency --remote",
    "seed:generate": "node scripts/generate-seed-sql.mjs",
    "seed:local": "npm run seed:generate && wrangler d1 execute englishfluency --local --file=scripts/seed.sql",
    "seed:remote": "npm run seed:generate && wrangler d1 execute englishfluency --remote --file=scripts/seed.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250525.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.9.2"
  }
}
